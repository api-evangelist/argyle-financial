{
  "opencollection": "1.0.0",
  "info": {
    "name": "Receipts API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Generate a receipt",
        "type": "http"
      },
      "http": {
        "method": "POST",
        "url": "{{baseUrl}}/v2/receipts",
        "body": {
          "type": "json",
          "data": "{}"
        }
      },
      "docs": "Returns a PDF listing all billable transactions associated with the user."
    }
  ],
  "bundled": true
}