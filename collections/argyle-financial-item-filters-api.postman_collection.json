      "item": [
        {
          "id": "42606fed-7520-42df-acbb-50e7bc405aa2",
          "name": "Create an Item filter",
          "request": {
            "name": "Create an Item filter",
            "description": {
              "content": "Filters are applied to properties of the `field_coverage` object of [Items](/api-reference/items#object) using the comparison operators below. You can also filter Items by their `status` property using the `eq` operator.\n\nThe name and ID of the new Item filter are returned in the response, which can be used as a query parameter when [listing Items](/api-reference/items#list).\n\n## Comparison operators\n\n`eq` — equals  \n`gt` — greater than  \n`gte` — greater than or equal to  \n`lt` — less than  \n`lte` — less than or equal to\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "item-filters"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"<string>\",\n  \"filters\": \"<object>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "60fc6dc5-88fa-48b5-9cf0-aa401d480840",
              "originalRequest": {
                "url": {
                  "path": [
                    "v2",
                    "item-filters"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: basic",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Basic <credentials>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Key paystub fields supported\",\n  \"filters\": {\n    \"status\": {\n      \"eq\": \"healthy\"\n    },\n    \"field_coverage\": {\n      \"paystubs\": {\n        \"gross_pay\": {\n          \"supported\": {\n            \"eq\": true\n          }\n        },\n        \"paystub_date\": {\n          \"supported\": {\n            \"eq\": true\n          }\n        }\n      }\n    }\n  }\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
