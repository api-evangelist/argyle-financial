        "description": {
          "content": "Creates a new user token from the `id` of an existing user for direct embedded Link initializations.\n\n<Note>\n[Creating a new user](/api-reference/users#create) will also return a user token in the response.\n</Note>\n",
          "type": "text/plain"
        },
        "url": {
