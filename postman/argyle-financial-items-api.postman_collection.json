                ],
                "url": {
                  "raw": "{{baseUrl}}/v2/items?q=<string>&id=<string>&kind=<string>&status=<string>&mapping_status=<string>&min_matching_score=<number>&filter_set=<uuid>&limit=<integer>&cursor=<string>",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "v2",
                    "items"
                  ],
                  "query": [
                    {
                      "description": "Free-text search filter. For best results, use the payroll platform or employer's full name.\n",
                      "key": "q",
                      "value": "<string>"
                    },
                    {
                      "description": "Filter by Item ID.\nMultiple Item IDs can also be searched at once using either method:\n\n1. `/v2/items?id=item_000000001,item_000000002`\n2. `/v2/items?id=item_000000001&id=item_000000002`\n",
                      "key": "id",
                      "value": "<string>"
                    },
                    {
                      "description": "Filter by `kind` value.",
                      "key": "kind",
                      "value": "<string>"
                    },
                    {
                      "description": "Filter by `status` value.\n\nMultiple `status` values can also be searched at once using either method:\n\n1. `/v2/items?status=healthy,issues`\n2. `/v2/items?status=healthy&status=issues`\n\nFiltering by both `healthy` and `issues` will return all Items that currently support new payroll connections.\n",
                      "key": "status",
                      "value": "<string>"
                    },
                    {
                      "description": "Filter by `mapping_status` value.\n\nMultiple `mapping_status` values can also be searched at once using either method:\n\n1. `/v2/items?mapping_status=verified,mapped`\n2. `/v2/items?mapping_status=verified&mapping_status=mapped`\n",
                      "key": "mapping_status",
                      "value": "<string>"
                    },
                    {
                      "description": "Only returns items with a [matching_score](/api-reference/items#object-matching_score) greater than or equal to this value.\n`min_matching_score` should be used together with the `q` \"free-text search\" query parameter.\n",
                      "key": "min_matching_score",
                      "value": "<number>"
                    },
                    {
                      "description": "Filter by Item filter ID.",
                      "key": "filter_set",
                      "value": "<uuid>"
                    },
                    {
                      "description": "Number of Item objects returned [per page](/api-guide/overview#pagination). Default: 10. Maximum: 200.\n",
                      "key": "limit",
                      "value": "<integer>"
                    },
                    {
                      "description": "The URL returned in `next` or `previous` used to retrieve another [page](/api-guide/overview#pagination) of results.",
                      "key": "cursor",
                      "value": "<string>"
                    }
                  ]
                },
                "description": "Returns a paginated list of all Item objects."
